# FreeLLMAPI on-premise 환경 변수 템플릿
#
# 복사: cp .env.example .env   → 값 채움   → chmod 600 .env
# 전체 변수 목록: https://github.com/tashfeenahmed/freellmapi/blob/main/.env.example
#
# 이 파일은 평문 시크릿을 담는다. .env 는 커밋하지 않는다.

# ── 필수 ────────────────────────────────────────────────────────────────
# provider API key 암호화 키 (64자 hex). 한 번 만들고 절대 바꾸지 않는다.
#   생성: openssl rand -hex 32
# 바꾸면 저장돼 있던 모든 provider key 가 복호화 불가가 된다.
# 교체 절차: https://github.com/tashfeenahmed/freellmapi/blob/main/docs/en/install/01-install.md#rotating-the-encryption-key
ENCRYPTION_KEY=

# ── 기본값 ──────────────────────────────────────────────────────────────
# 호스트에 publish 되는 포트 (컨테이너 내부 포트는 항상 3001)
PORT=3001

# 포트를 공개할 인터페이스
#   127.0.0.1 = 이 머신에서만 접속 (기본값)
#   0.0.0.0   = 같은 네트워크의 다른 장비에서도 접속 — 신뢰된 LAN 에서만
HOST_BIND=127.0.0.1

# ── 선택 ────────────────────────────────────────────────────────────────
# 앞에 리버스 프록시(Caddy/nginx/Traefik)를 두면 실제 클라이언트 IP 를 신뢰한다.
#   TRUST_PROXY=1

# 대시보드 "Update now" 를 쓸 때만. docker compose --profile autoupdate up -d
#   WATCHTOWER_TOKEN=

# 암호화 백업 (에피메릭 디스크 대비). 생략 시 ENCRYPTION_KEY 를 백업 키로 재사용.
#   FREEAPI_DB_BACKUP_PATH=/app/server/data/freellmapi.db.backup
#   FREEAPI_DB_BACKUP_KEY=
#   FREEAPI_DB_BACKUP_INTERVAL_MS=300000

# 호스트에 프록시(Clash, v2rayN, 사내 프록시)가 있고 그걸 통해서만 외부 API 에 닿을 때.
# 컨테이너 안에서 127.0.0.1 은 컨테이너 자신이다. 호스트를 가리키려면 host.docker.internal.
#   PROXY_URL=socks5h://host.docker.internal:7890

# 선언형 시작 설정(관리자 계정 · provider key · 폴백 체인 · 라우팅 전략).
# provider key 를 파일로 넣고 싶을 때. 평문 시크릿이므로 ENCRYPTION_KEY 와 같은 수준으로 보호.
#   FREEAPI_CONFIG_PATH=/app/server/data/freellmapi.config.json
